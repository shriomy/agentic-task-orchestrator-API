# Same values as trip-agent/.env — this server manages the SAME MongoDB
# collection and verifies tokens against the SAME Supabase project.

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
MONGODB_URI=
MONGODB_DB_NAME=travel_discovery
MONGODB_FAVORITES_COLLECTION=agent_favorites

# ---------------------------------------------------------------------------
# Supabase (token verification only — no service-role writes from here)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Legacy HS256 projects only; leave blank for JWKS/RS256 projects.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# ---------------------------------------------------------------------------
# App settings
# ---------------------------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=20
MCP_PORT=8001
