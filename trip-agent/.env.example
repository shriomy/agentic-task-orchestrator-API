# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
# Either set LLM_API_KEY for OpenAI directly, or set OPENROUTER_API_KEY and the
# code routes through OpenRouter's OpenAI-compatible endpoint automatically.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
# Cheap model used by the scope/output guardrail classifiers and the summarizer.
LLM_FAST_MODEL=gpt-4o-mini

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=

# ---------------------------------------------------------------------------
# Supabase — auth, chat history (agent_* tables), and the checkpointer database
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string for the LangGraph checkpointer. Use the SESSION
# pooler URI from Supabase → Project Settings → Database. Without it the agent
# still runs but thread state is in-memory and lost on restart.
SUPABASE_DB_URL=
# Only needed for legacy HS256 projects. Newer projects verify via JWKS, which
# needs no secret here.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
# Never set this to false outside local development — it accepts unverified tokens.
REQUIRE_AUTH=true

# ---------------------------------------------------------------------------
# Tavily — web search
# ---------------------------------------------------------------------------
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# OpenTripMap — places to visit
# ---------------------------------------------------------------------------
OPENTRIPMAP_API_KEY=
OPENTRIPMAP_ROOT_URL=https://api.opentripmap.com/0.1
OPENTRIPMAP_LANG=en

# ---------------------------------------------------------------------------
# Ticketmaster — events and activities
# ---------------------------------------------------------------------------
TICKETMASTER_API_KEY=
TICKETMASTER_ROOT_URL=https://app.ticketmaster.com/discovery/v2/

# ---------------------------------------------------------------------------
# Booking.com via RapidAPI — accommodations
# ---------------------------------------------------------------------------
X_RAPIDAPI_KEY=
RAPIDAPI_BOOKING_HOST=booking-com15.p.rapidapi.com

# ---------------------------------------------------------------------------
# MongoDB — favorites (saved trips)
# ---------------------------------------------------------------------------
MONGODB_URI=
MONGODB_DB_NAME=travel_discovery
MONGODB_FAVORITES_COLLECTION=agent_favorites

# ---------------------------------------------------------------------------
# LangSmith tracing
# ---------------------------------------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT_NAME=travel-discovery-agent
LANGSMITH_TRACING=true

# ---------------------------------------------------------------------------
# App settings
# ---------------------------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=20
# Ceiling on agent<->tool round trips within a single turn.
MAX_TOOL_ROUNDS=12
# Message-history token budget before the summarizer compresses older turns.
SUMMARY_TOKEN_THRESHOLD=6000
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
