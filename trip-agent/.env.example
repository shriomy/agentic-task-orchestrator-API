# Tavily
TAVILY_API_KEY=

# OpenTripMap
OPENTRIPMAP_API_KEY=

# Ticketmaster
TICKETMASTER_API_KEY=

# Hotel search (placeholder)
HOTEL_SEARCH_PROVIDER=amadeus
HOTEL_SEARCH_API_KEY=

# MongoDB favorites
MONGODB_URI=
MONGODB_DB_NAME=travel_discovery
MONGODB_FAVORITES_COLLECTION=favorites

# OpenRouter (optional)
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=

# Langsmith / tracing
LANGSMITH_API_KEY=
